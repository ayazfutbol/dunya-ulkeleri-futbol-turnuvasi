rules_version = '2';
service firebase.storage {
  match /b/{bucket}/o {
    match /published-games/{allPaths=**} {
      allow read: if true;
      allow write: if request.auth != null
        && request.auth.token.email != null
        && request.auth.token.email == 'ayazakcay599@gmail.com';
    }
  }
}
