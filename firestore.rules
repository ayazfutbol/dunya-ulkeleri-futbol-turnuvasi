rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    function signedIn() {
      return request.auth != null;
    }

    function isAdmin() {
      return signedIn() && request.auth.token.email == 'ayazakcay599@gmail.com';
    }

    match /users/{uid} {
      allow read, create, update: if signedIn() && (request.auth.uid == uid || isAdmin());
      allow delete: if isAdmin();
    }

    match /blockedUsers/{uid} {
      allow read: if signedIn() && (request.auth.uid == uid || isAdmin());
      allow create, update, delete: if isAdmin();
    }

    match /adminConfig/{docId} {
      allow read: if signedIn();
      allow write: if isAdmin();
    }

    match /gameState/{docId} {
      allow read: if signedIn();
      // Şampiyonluk ödülünü oyuncunun tarayıcısından kaydetmek için açık tutulur.
      // Ücretsiz prototip sürümüdür; ileride Cloud Functions ile daha sıkı güvenlik eklenebilir.
      allow create, update: if signedIn();
      allow delete: if isAdmin();
    }

    match /gameCode/{docId} {
      allow read: if signedIn();
      allow write: if isAdmin();
    }

    match /gameCodeVersions/{docId} {
      allow read, write: if isAdmin();
    }

    match /{document=**} {
      allow read, write: if false;
    }
  }
}
