rules_version = '2';

service cloud.firestore {
  match /databases/{database}/documents {
    function signedIn() {
      return request.auth != null;
    }

    function owner() {
      return signedIn()
        && request.auth.token.email != null
        && request.auth.token.email == 'ayazakcay599@gmail.com';
    }

    // Sahip hesap veya sahip tarafından adminConfig/main içindeki
    // adminEmails listesine eklenmiş hesaplar yönetici kabul edilir.
    function isAdmin() {
      return owner()
        || (signedIn()
          && request.auth.token.email != null
          && exists(/databases/$(database)/documents/adminConfig/main)
          && request.auth.token.email in get(/databases/$(database)/documents/adminConfig/main).data.adminEmails);
    }

    // Oyunun genel gücü / maç sistemi.
    match /gameState/{stateId} {
      allow read, create, update: if signedIn();
    }

    // Oyuncu profili: kişi sadece kendi profilini değiştirebilir;
    // yönetici ise tüm kullanıcıları görebilir.
    match /users/{userId} {
      allow read: if signedIn() && (request.auth.uid == userId || isAdmin());
      allow create, update: if signedIn() && (request.auth.uid == userId || isAdmin());
      allow delete: if isAdmin() || (signedIn() && request.auth.uid == userId);
    }

    // Bakım / tema / logo ayarları herkese okunabilir.
    // Sahip veya yetkilendirilmiş admin değiştirebilir.
    // adminEmails listesini yalnızca sahip değiştirebilir.
    match /adminConfig/{configId} {
      allow read: if true;
      allow create: if owner();
      allow update: if isAdmin()
        && (owner() || request.resource.data.adminEmails == resource.data.adminEmails);
      allow delete: if owner();
    }

    // Yönetici tarafından yayınlanan tam oyun kodu.
    match /gameCode/{codeId} {
      allow read: if true;
      allow create, update, delete: if isAdmin();
    }

    // Yönetim panelindeki kod sürüm geçmişi.
    match /gameCodeVersions/{versionId} {
      allow read, create, update, delete: if isAdmin();
    }

    // Engellenen kullanıcılar: yalnızca yönetici yönetebilir.
    match /blockedUsers/{userId} {
      allow read: if signedIn() && (request.auth.uid == userId || isAdmin());
      allow create, update, delete: if isAdmin();
    }
  }
}
